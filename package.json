    "typecheck": "tsc --noEmit -p tsconfig.json",
    "reembed": "node --no-warnings scripts/reembed.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
